/* ---- Spider-Punk rofi theme ----
 * Matches the Spider-Punk bar / Control Center: a torn black panel with a crimson
 * misprint (assets/punk/panel-rofi.png), crimson search strip, poster-type results,
 * selection = crimson sticker with a blue misprint edge (right/bottom border).
 * Tokens: ~/.config/hypr/waybar/style/punk/tokens.css
 * Previous theme: themes/Island.rasi (config.rasi @theme)
 */
configuration {
    show-icons:           true;
    display-drun:         "APPS";
    display-run:          "RUN";
    display-filebrowser:  "FILES";
    display-window:       "WINDOWS";
    drun-display-format:  "{name}";
    window-format:        "{w} · {c} · {t}";
    hover-select:         true;
    me-select-entry:      "MouseSecondary";
    me-accept-entry:      "MousePrimary";
}

* {
    font:              "JetBrainsMono Nerd Font Bold 12";
    bg:                #0B090D;
    bg2:               #151117;
    surface:           #1E151C;
    ink:               #050306;
    fg:                #F5F0E8;
    sub:               #AAA2B2;
    faint:             #6E6676;
    crimson:           #FF1744;
    blue:              #00B8FF;
    yellow:            #FFD43B;
    magenta:           #FF2E93;
    background-color:  transparent;
    text-color:        @fg;
    border-color:      @ink;
}

window {
    transparency:      "real";
    location:          north;
    anchor:            north;
    y-offset:          15%;
    width:             700px;
    border:            0px;
    border-radius:     0px;
    background-color:  transparent;
    background-image:  url("~/.config/hypr/waybar/assets/punk/panel-rofi.png", both);
    padding:           18px 26px 28px 20px;     /* right/bottom: room for the printed misprint */
    cursor:            "default";
}
mainbox {
    padding:           0px;
    spacing:           12px;
    background-color:  transparent;
    children:          [ "inputbar", "message", "listview", "mode-switcher" ];
}

/* ---- search strip: crimson poster band with a lightning bolt ---- */
inputbar {
    padding:           0px 16px;
    spacing:           12px;
    border:            3px 6px 6px 3px;          /* thick ink outline, heavier bottom/right = misprint depth */
    border-color:      @ink;
    background-color:  @crimson;
    children:          [ "textbox-search", "entry", "textbox-tag" ];
}
textbox-search {
    expand:            false;
    str:               "󱐋";
    font:              "JetBrainsMono Nerd Font 20";
    text-color:        @yellow;
    vertical-align:    0.5;
    background-color:  transparent;
}
entry {
    padding:           14px 0px;
    font:              "JetBrainsMono Nerd Font Bold 15";
    text-color:        @fg;
    placeholder-color: rgba(245, 240, 232, 65%);
    placeholder:       "type it. loud.";
    cursor:            text;
    vertical-align:    0.5;
    background-color:  transparent;
}
textbox-tag {
    expand:            false;
    str:               "SEARCH!";
    font:              "Bangers 20";
    text-color:        @ink;
    vertical-align:    0.5;
    background-color:  transparent;
}
prompt, textbox-prompt-colon, case-indicator, num-filtered-rows, num-rows, textbox-num-sep { enabled: false; }

/* ---- message (-mesg): a cream paper strip ---- */
message {
    padding:           0px;
    background-color:  transparent;
}
textbox {
    padding:           8px 12px;
    border:            2px 4px 4px 2px;
    border-color:      @ink;
    background-color:  @fg;
    text-color:        @ink;
    vertical-align:    0.5;
    markup:            true;
}

/* ---- results ---- */
listview {
    padding:           2px 4px;
    spacing:           4px;
    lines:             8;
    columns:           1;
    fixed-height:      false;
    fixed-columns:     true;
    dynamic:           true;
    cycle:             true;
    scrollbar:         false;
    background-color:  transparent;
    cursor:            "default";
}
element {
    padding:           6px 12px;
    spacing:           12px;
    border:            0px 0px 0px 3px;
    border-radius:     0px;
    border-color:      transparent;
    orientation:       horizontal;
    children:          [ "element-icon", "element-text" ];
    cursor:            pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element normal.active, element alternate.active { background-color: transparent; text-color: @blue; border-color: @blue; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @yellow; border-color: @yellow; }
/* selected: crimson sticker, ink outline, blue misprint on the right/bottom */
element selected.normal, element selected.active, element selected.urgent {
    background-color:  @crimson;
    text-color:        @fg;
    border:            2px 5px 5px 2px;
    border-color:      @blue;
}
element-icon {
    size:              28px;
    vertical-align:    0.5;
    background-color:  transparent;
    text-color:        inherit;
    cursor:            inherit;
}
element-text {
    font:              "Bebas Neue 19";
    vertical-align:    0.5;
    horizontal-align:  0.0;
    background-color:  transparent;
    text-color:        inherit;
    highlight:         bold underline #FFD43B;
    cursor:            inherit;
}

/* ---- modes (apps / run / files…) as ink-stamped tabs ---- */
mode-switcher {
    padding:           0px 4px;
    spacing:           8px;
    background-color:  transparent;
}
button {
    padding:           4px 14px;
    font:              "Bebas Neue 17";
    border:            2px 4px 4px 2px;
    border-color:      @ink;
    border-radius:     0px;
    background-color:  @surface;
    text-color:        @sub;
    cursor:            pointer;
}
button selected { background-color: @blue; text-color: @ink; }

error-message {
    padding:           16px 20px;
    border:            3px 6px 6px 3px;
    border-color:      @crimson;
    border-radius:     0px;
    background-color:  @bg;
    text-color:        @fg;
}
